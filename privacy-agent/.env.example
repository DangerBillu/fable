PRIVACY_MODE=STRICT
USE_OLLAMA=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
VISION_MODEL=llava
PRIVACY_MODEL=

# Hugging Face Inference API
HF_API_TOKEN=
HF_VISION_MODEL=Salesforce/blip2-opt-2.7b
HF_TEXT_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Face Detection
FACE_DETECTION=1

# Policy Profile (strict | isro)
POLICY_PROFILE=isro

# Optional Real SMTP Email Sending (e.g. Gmail App Password)
# If left blank, JARVIS automatically writes emails to outbox/latest_flight_report.html
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ISRO Mission Control <mission-control@isro.gov.in>
