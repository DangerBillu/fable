{
  "manifest_version": 3,
  "name": "Privacy Agent",
  "description": "Local privacy firewall around a browser-use agent.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "background": {
    "service_worker": "src/browser/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Privacy Agent",
    "default_popup": "src/ui/dashboard.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/dom/content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116"
}

